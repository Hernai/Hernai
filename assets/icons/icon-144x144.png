<svg width="512" height="512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="512" height="512" fill="url(#grad)" rx="80"/>

  <!-- INE Card Shape -->
  <rect x="96" y="176" width="320" height="200" fill="white" rx="16" opacity="0.95"/>

  <!-- Card Details -->
  <rect x="116" y="196" width="100" height="60" fill="#667eea" opacity="0.3" rx="4"/>
  <rect x="116" y="266" width="280" height="8" fill="#667eea" opacity="0.5" rx="2"/>
  <rect x="116" y="284" width="240" height="8" fill="#667eea" opacity="0.5" rx="2"/>
  <rect x="116" y="302" width="200" height="8" fill="#667eea" opacity="0.5" rx="2"/>
  <rect x="116" y="320" width="160" height="8" fill="#667eea" opacity="0.5" rx="2"/>

  <!-- AI Symbol -->
  <circle cx="256" cy="416" r="40" fill="white" opacity="0.9"/>
  <text x="256" y="432" font-family="Arial, sans-serif" font-size="36" fill="#667eea" text-anchor="middle" font-weight="bold">AI</text>

  <!-- Scanner Lines -->
  <line x1="80" y1="150" x2="432" y2="150" stroke="white" stroke-width="3" opacity="0.6"/>
  <line x1="80" y1="400" x2="432" y2="400" stroke="white" stroke-width="3" opacity="0.6"/>
</svg>
